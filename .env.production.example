APP_NAME="Attendance ETC1992"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://attendance.etc1992.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=attendance_etc1992
DB_USERNAME=attendance_user
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Face Recognition API
# FACE_RECOGNITION_API_URL is unused by the app - the code only reads FACE_API_URL
# (config/services.php -> services.face_api.url). The Python service binds to 8001
# (python/face_api.py), not 8000 - without FACE_API_URL set, it silently falls back
# to the wrong port and every face scan times out.
FACE_RECOGNITION_API_URL=http://127.0.0.1:8000
FACE_API_URL=http://127.0.0.1:8001

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sanctum
SANCTUM_STATEFUL_DOMAINS=attendance.etc1992.com
